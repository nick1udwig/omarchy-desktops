--- i/src/managers/screenshare/ScreenshareSession.cpp
+++ w/src/managers/screenshare/ScreenshareSession.cpp
@@ -5,9 +5,31 @@
 #include "../EventManager.hpp"
 #include "../eventLoop/EventLoopManager.hpp"
 #include "../../event/EventBus.hpp"
+#include <cstdlib>
+#include <cmath>
+#include <string_view>
 
 using namespace Screenshare;
 
+// Experiment only: affects all window captures in this compositor process.
+// Run in a disposable nested compositor, never in the desktop session.
+static int thumbnailDivisor() {
+    static const int divisor = []() {
+        const char* value = std::getenv("OMARCHY_CAPTURE_DIVISOR");
+        if (!value)
+            return 1;
+        const std::string_view text{value};
+        if (text == "2")
+            return 2;
+        if (text == "4")
+            return 4;
+        if (text == "8")
+            return 8;
+        return 1;
+    }();
+    return divisor;
+}
+
 CScreenshareSession::CScreenshareSession(PHLMONITOR monitor, wl_client* client) : m_type(SHARE_MONITOR), m_monitor(monitor), m_client(client) {
     if UNLIKELY (!m_monitor)
         return;
@@ -118,7 +140,9 @@ void CScreenshareSession::calculateConstraints() {
             break;
         case SHARE_WINDOW:
             m_bufferSize = (m_window->size(Desktop::View::IGeometric::GEOMETRIC_CURRENT) * PMONITOR->m_scale).round();
-            m_name       = m_window->m_title;
+            if (m_bufferSize.x > 0 && m_bufferSize.y > 0)
+                m_bufferSize = {std::ceil(m_bufferSize.x / thumbnailDivisor()), std::ceil(m_bufferSize.y / thumbnailDivisor())};
+            m_name = m_window->m_title;
             break;
         case SHARE_REGION:
             m_bufferSize = PMONITOR->m_transform % 2 == 0 ? m_captureBox.size() : Vector2D{m_captureBox.h, m_captureBox.w};
